<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp rescap">
  <Identity Name="GamerDad.CemuForGameVault" Publisher="CN=GamerDad" Version="0.2.6.110" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="2387940d-94ad-404e-b5e7-19d05f8242e7" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Game Vault · Wii U (Cemu)</DisplayName>
    <PublisherDisplayName>Skitzelles (Cemu build, Xbox port by DanP142)</PublisherDisplayName>
    <Logo>resources/StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00"
      MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="CemuUwp" Executable="$targetnametoken$.exe" EntryPoint="CemuUwp.App">
      <uap:VisualElements
        DisplayName="Game Vault · Wii U (Cemu)"
        Description="Cemu, the Wii U emulator, for Game Vault. Xbox port by DanP142. Wii U is a trademark of Nintendo; Cemu is not affiliated with Nintendo."
        Square150x150Logo="resources/Square150x150Logo.png"
        Square44x44Logo="resources/Square44x44Logo.png"
        BackgroundColor="#202020">
        <uap:DefaultTile Square71x71Logo="resources/Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="cemu">
            <uap:DisplayName>Cemu</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Game Vault's own link, so another Cemu installed next to it stays as it is -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gamevault-cemu">
            <uap:DisplayName>Cemu for Game Vault</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="cemu-content">
            <uap:SupportedFileTypes>
              <uap:FileType>.wua</uap:FileType>
              <uap:FileType>.wux</uap:FileType>
              <uap:FileType>.wud</uap:FileType>
              <uap:FileType>.rpx</uap:FileType>
              <uap:FileType>.elf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <!-- Game Vault's shared folder (same publisher): the one-time sign-in for a game on a network share (netcred) -->
  <Extensions>
    <Extension Category="windows.publisherCacheFolders">
      <PublisherCacheFolders>
        <Folder Name="games" />
      </PublisherCacheFolders>
    </Extension>
  </Extensions>
  <Capabilities>
    <rescap:Capability Name="expandedResources" />
    <rescap:Capability Name="broadFileSystemAccess" />
    <Capability Name="codeGeneration" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
